# Unity generated files
[Ll]ibrary/
[Tt]emp/
[Bb]uild/
[Bb]uilds/
Obj/
MemoryCaptures/
UserSettings/
Logs/
*.csproj
*.unityproj
*.sln
*.apk
*.aab
*.xcodeproj
*.xcworkspace

# OS
.DS_Store
Thumbs.db

# Visual Studio
.vscode/
*.user
*.suo
*.userprefs

# Auto-generated by Unity
sysinfo.txt

# Exclude build artifacts and exports
*.exe
*.app
*.apk
*.unitypackage

# Keep source: Assets, ProjectSettings, Packages, .meta files

# Ignore local Unity cache
*/Library/
*/Temp/
*/Obj/

# Ignore player data caches
Library/PlayerDataCache/

# Ignore Gradle and other build directories
.gradle/

# Ignore packaged distributables
dist/
build/

# Runtime portable song library (kept beside the game executable/project).
UserSongs/

# Keep meta files tracked
!**/*.meta

# 曲庫與歌曲資產（不進版控；曲庫另外以 ZIP 發行）
UserSongs*/
Assets/Resources/songs.zip
Assets/Resources/songs.zip.meta

# Unity 自動回復的場景、工具產生的備份與紀錄
Assets/_Recovery/
Assets/_Recovery.meta
tools/corrupt_image_backups/
*.log
